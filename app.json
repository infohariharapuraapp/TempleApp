{
  "expo": {
    "name": "Divyakshetra Hariharapura",
    "slug": "TempleApp",
    "owner": "hariharapuratempleapps-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "templeapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.sreemathhariharapura.templeapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sreemathhariharapura.templeapp",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withIOSProductionSecurity",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidOptimization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "The secure storage library supports Face ID protection for sensitive information. The current app does not request Face ID authentication."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "The included audio library supports microphone access. The current app uses audio playback only and does not request microphone access."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6B1720",
          "defaultChannel": "default"
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Divyakshetra Hariharapura to select your volunteer photograph for ID card generation.",
          "cameraPermission": "Allow Divyakshetra Hariharapura to capture your volunteer photograph.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56f14d0d-70d9-4b4e-a916-3dd9c3464585"
      }
    }
  }
}
